{
  "name": "marvel-local-emulators",
  "private": true,
  "scripts": {
    "emulators": "firebase emulators:start --project demo-marvel-local --only auth,firestore,functions,storage",
    "check:local": "firebase emulators:exec --project demo-marvel-local --only auth,firestore,functions,storage \"node tools/check-firebase-local.cjs\"",
    "providers:status": "node tools/provider-status.cjs",
    "check:providers": "firebase emulators:exec --project demo-marvel-local --only auth,functions \"node tools/check-provider-configuration-local.cjs\""
  },
  "devDependencies": {
    "firebase-tools": "15.32.1"
  }
}

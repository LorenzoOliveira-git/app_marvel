<resources>
    <style name="ShapeAppearance.Marvel.Avatar" parent=""><item name="cornerFamily">rounded</item><item name="cornerSize">50%</item></style>
    <style name="TextAppearance.Marvel.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/bebas_neue_regular</item><item name="fontFamily">@font/bebas_neue_regular</item>
        <item name="android:textAllCaps">true</item><item name="lineHeight">44sp</item>
        <item name="android:textSize">@dimen/text_display</item><item name="android:textColor">@color/marvel_text</item>
    </style>
    <style name="TextAppearance.Marvel.Title" parent="TextAppearance.Marvel.Display"><item name="android:textSize">@dimen/text_title</item><item name="lineHeight">34sp</item></style>
    <style name="TextAppearance.Marvel.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/barlow</item><item name="fontFamily">@font/barlow</item>
        <item name="lineHeight">22sp</item><item name="android:textSize">@dimen/text_body</item><item name="android:textColor">@color/arquivo_texto_corpo</item>
    </style>
    <style name="TextAppearance.Marvel.Caption" parent="TextAppearance.Marvel.Body"><item name="android:textSize">@dimen/text_caption</item><item name="lineHeight">16sp</item><item name="android:textColor">@color/arquivo_texto_corpo</item></style>
    <style name="Widget.Marvel.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/touch_min</item><item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/barlow_semibold</item><item name="fontFamily">@font/barlow_semibold</item><item name="android:textSize">@dimen/text_action</item><item name="android:textColor">@color/button_text</item>
        <item name="backgroundTint">@color/button_background</item><item name="cornerRadius">@dimen/field_radius</item>
        <item name="rippleColor">@color/marvel_ripple</item>
    </style>
    <style name="Widget.Marvel.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/touch_min</item><item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/barlow_semibold</item><item name="android:textSize">@dimen/text_action</item><item name="android:textColor">@color/marvel_text</item><item name="backgroundTint">@color/arquivo_folha</item><item name="strokeColor">@color/marvel_border</item>
        <item name="cornerRadius">@dimen/field_radius</item>
    </style>
    <style name="Widget.Marvel.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/marvel_surface</item><item name="boxStrokeColor">@color/field_stroke</item>
        <item name="hintTextColor">@color/marvel_text_secondary</item>
        <item name="boxCornerRadiusTopStart">@dimen/field_radius</item><item name="boxCornerRadiusTopEnd">@dimen/field_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/field_radius</item><item name="boxCornerRadiusBottomEnd">@dimen/field_radius</item>
    </style>
    <style name="Widget.Marvel.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/arquivo_folha</item><item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="strokeColor">@color/marvel_border</item><item name="strokeWidth">1dp</item><item name="cardElevation">0dp</item>
    </style>
    <style name="TextAppearance.Marvel.AuthTitle" parent="TextAppearance.Marvel.Display">
        <item name="android:textSize">40sp</item>
    </style>
    <style name="TextAppearance.Marvel.AuthLabel" parent="TextAppearance.Marvel.Body">
        <item name="android:fontFamily">@font/barlow_semibold</item><item name="fontFamily">@font/barlow_semibold</item>
        <item name="android:textSize">14sp</item><item name="lineHeight">20sp</item><item name="android:textColor">@color/arquivo_tinta</item>
    </style>
    <style name="Widget.Marvel.AuthInput" parent="Widget.Marvel.TextInput">
        <item name="hintEnabled">false</item>
        <item name="boxStrokeColor">@color/auth_field_stroke</item>
        <item name="boxStrokeWidth">1dp</item><item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/field_radius</item><item name="boxCornerRadiusTopEnd">@dimen/field_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/field_radius</item><item name="boxCornerRadiusBottomEnd">@dimen/field_radius</item>
    </style>
    <style name="Widget.Marvel.AuthEditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:fontFamily">@font/barlow</item><item name="fontFamily">@font/barlow</item>
        <item name="android:textSize">14sp</item><item name="android:textColor">@color/marvel_text</item>
        <item name="android:textColorHint">@color/arquivo_texto_corpo</item><item name="android:minHeight">48dp</item>
        <item name="android:paddingTop">12dp</item><item name="android:paddingBottom">12dp</item>
        <item name="android:paddingStart">16dp</item><item name="android:paddingEnd">16dp</item>
    </style>
    <style name="Widget.Marvel.AuthButton" parent="Widget.Marvel.Button.Primary" />
    <style name="Widget.Marvel.AuthLink" parent="Widget.Material3.Button.TextButton">
        <item name="android:fontFamily">@font/barlow_semibold</item><item name="fontFamily">@font/barlow_semibold</item>
        <item name="android:textSize">@dimen/text_action</item><item name="android:textColor">@color/arquivo_vermelho_texto</item>
        <item name="android:textAllCaps">false</item><item name="android:gravity">start|center_vertical</item>
        <item name="android:singleLine">false</item><item name="android:maxLines">3</item>
        <item name="android:paddingStart">0dp</item><item name="android:paddingEnd">0dp</item>
        <item name="android:minHeight">48dp</item><item name="rippleColor">@color/marvel_ripple</item>
    </style>
    <style name="Widget.Marvel.Button.Marvel" parent="Widget.Marvel.Button.Primary">
        <item name="backgroundTint">@color/button_marvel_background</item>
    </style>
    <style name="TextAppearance.Marvel.Section" parent="TextAppearance.Marvel.Display">
        <item name="android:textSize">@dimen/text_section</item><item name="lineHeight">22sp</item>
    </style>
    <style name="TextAppearance.Marvel.CardTitle" parent="TextAppearance.Marvel.Display">
        <item name="android:textSize">@dimen/text_card</item><item name="lineHeight">24sp</item>
    </style>
    <style name="TextAppearance.Marvel.Highlight" parent="TextAppearance.Marvel.Display">
        <item name="android:textSize">@dimen/text_highlight</item><item name="lineHeight">28sp</item>
    </style>
    <style name="TextAppearance.Marvel.Label" parent="TextAppearance.Marvel.AuthLabel">
        <item name="android:textSize">@dimen/text_label</item><item name="lineHeight">14sp</item>
    </style>
    <style name="ShapeAppearance.Marvel.NavIndicator" parent="">
        <item name="cornerFamily">rounded</item><item name="cornerSize">50%</item>
    </style>
    <style name="TextAppearance.Marvel.BodyStrong" parent="TextAppearance.Marvel.Body">
        <item name="android:fontFamily">@font/barlow_semibold</item><item name="fontFamily">@font/barlow_semibold</item>
        <item name="lineHeight">20sp</item><item name="android:textColor">@color/arquivo_tinta</item>
    </style>

    <style name="ShapeAppearance.Marvel.Cover" parent=""><item name="cornerFamily">rounded</item><item name="cornerSize">4dp</item></style>
    <style name="Widget.Marvel.SectionHeading" parent="TextAppearance.Marvel.Section"><item name="android:paddingBottom">8dp</item><item name="android:background">@drawable/background_section_line</item></style>
    <style name="Widget.Marvel.SearchInput" parent="Widget.Marvel.AuthInput"><item name="startIconDrawable">@drawable/ic_arquivo_search</item><item name="startIconTint">@color/arquivo_tinta</item><item name="endIconMode">clear_text</item></style>
    <style name="Widget.Marvel.MenuRow" parent="Widget.Marvel.AuthLink"><item name="android:minHeight">52dp</item><item name="android:textColor">@color/arquivo_tinta</item><item name="android:textSize">14sp</item><item name="android:background">@drawable/background_section_line</item></style>
    <style name="Widget.Marvel.Button.Destructive" parent="Widget.Marvel.AuthLink"><item name="android:textColor">@color/arquivo_erro</item></style>
    <style name="ThemeOverlay.Marvel.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/arquivo_folha</item>
        <item name="alertDialogStyle">@style/Widget.Marvel.Dialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Widget.Marvel.Dialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/Widget.Marvel.Dialog.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Marvel.Dialog.SafeAction</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Marvel.Dialog.OtherAction</item>
    </style>
    <!-- Title style is a view style: keep the required Material layout dimensions. -->
    <style name="Widget.Marvel.Dialog.Title" parent="MaterialAlertDialog.Material3.Title.Text"><item name="android:textAppearance">@style/TextAppearance.Marvel.Highlight</item><item name="android:textColor">@color/arquivo_tinta</item><item name="android:fontFamily">@font/bebas_neue_regular</item><item name="android:textAllCaps">true</item></style>
    <style name="Widget.Marvel.Dialog.Body" parent="MaterialAlertDialog.Material3.Body.Text"><item name="android:textAppearance">@style/TextAppearance.Marvel.Body</item><item name="android:textColor">@color/arquivo_texto_corpo</item></style>
    <style name="Widget.Marvel.Dialog" parent="MaterialAlertDialog.Material3"><item name="shapeAppearance">@style/ShapeAppearance.Marvel.Dialog</item></style>
    <style name="ShapeAppearance.Marvel.Dialog" parent=""><item name="cornerFamily">rounded</item><item name="cornerSize">12dp</item></style>
    <style name="Widget.Marvel.Dialog.SafeAction" parent="Widget.Material3.Button.TextButton.Dialog"><item name="android:textColor">@color/arquivo_sobre_vermelho</item><item name="backgroundTint">@color/arquivo_vermelho</item><item name="cornerRadius">8dp</item><item name="android:minHeight">48dp</item><item name="android:textAllCaps">false</item><item name="android:fontFamily">@font/barlow_semibold</item></style>
    <style name="Widget.Marvel.Dialog.OtherAction" parent="Widget.Material3.Button.TextButton.Dialog"><item name="android:textColor">@color/arquivo_tinta</item><item name="android:minHeight">48dp</item><item name="android:textAllCaps">false</item><item name="android:fontFamily">@font/barlow_semibold</item></style>
</resources>

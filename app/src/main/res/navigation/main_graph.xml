<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_graph" app:startDestination="@id/loginFragment">
    <fragment android:id="@+id/loginFragment" android:name="com.example.app_marvel.ui.auth.AuthFragment" android:label="@string/auth_login_title">
        <argument android:name="returnToHero" app:argType="boolean" android:defaultValue="false" />
        <argument android:name="register" app:argType="boolean" android:defaultValue="false" />
    </fragment>
    <fragment android:id="@+id/registerFragment" android:name="com.example.app_marvel.ui.auth.AuthFragment" android:label="@string/auth_register_title">
        <argument android:name="returnToHero" app:argType="boolean" android:defaultValue="false" />
        <argument android:name="register" app:argType="boolean" android:defaultValue="true" />
    </fragment>
    <fragment android:id="@id/homeFragment" android:name="com.example.app_marvel.ui.home.HomeFragment" android:label="@string/nav_home" />
    <fragment android:id="@id/charactersFragment" android:name="com.example.app_marvel.ui.characters.CharactersFragment" android:label="@string/nav_characters">
        <argument android:name="feature" app:argType="string" android:defaultValue="CHARACTERS" />
    </fragment>
    <fragment android:id="@+id/characterDetailsFragment" android:name="com.example.app_marvel.ui.details.CharacterDetailsFragment" android:label="@string/nav_characters">
        <argument android:name="characterId" app:argType="integer" />
    </fragment>
    <fragment android:id="@id/storiesFragment" android:name="com.example.app_marvel.ui.history.StoriesFragment" android:label="@string/nav_stories">
        <argument android:name="feature" app:argType="string" android:defaultValue="STORIES" />
    </fragment>
    <fragment android:id="@+id/issueDetailsFragment" android:name="com.example.app_marvel.ui.issues.IssueDetailsFragment" android:label="@string/issue_details_title">
        <argument android:name="issueId" app:argType="integer" />
    </fragment>
    <fragment android:id="@+id/arcDetailsFragment" android:name="com.example.app_marvel.ui.arcs.ArcDetailsFragment" android:label="@string/arc_details_title">
        <argument android:name="arcId" app:argType="integer" />
    </fragment>
    <fragment android:id="@+id/arcsFragment" android:name="com.example.app_marvel.ui.arcs.ArcsFragment" android:label="@string/arcs_title" />
    <fragment android:id="@+id/comicsFragment" android:name="com.example.app_marvel.ui.comics.ComicsFragment" android:label="@string/comics_title" />
    <fragment android:id="@+id/characterHistoryFragment" android:name="com.example.app_marvel.ui.history.CharacterHistoryFragment" android:label="@string/nav_stories">
        <argument android:name="characterId" app:argType="integer" />
    </fragment>
    <fragment android:id="@id/createHeroFragment" android:name="com.example.app_marvel.ui.createhero.CreateHeroFragment" android:label="@string/nav_create">
        <argument android:name="feature" app:argType="string" android:defaultValue="CREATE_HERO" />
    </fragment>
    <fragment android:id="@id/profileFragment" android:name="com.example.app_marvel.ui.auth.AccountFragment" android:label="@string/nav_profile">
        <argument android:name="feature" app:argType="string" android:defaultValue="PROFILE" />
    </fragment>
    <fragment android:id="@+id/moviesFragment" android:name="com.example.app_marvel.ui.movies.MoviesFragment" android:label="@string/movies_title" />
    <fragment android:id="@+id/movieDetailsFragment" android:name="com.example.app_marvel.ui.movies.MovieDetailsFragment" android:label="@string/movie_details_title">
        <argument android:name="movieId" app:argType="integer" />
    </fragment>
    <fragment android:id="@+id/seriesFragment" android:name="com.example.app_marvel.ui.series.SeriesFragment" android:label="@string/series_title" />
    <fragment android:id="@+id/seriesDetailsFragment" android:name="com.example.app_marvel.ui.series.SeriesDetailsFragment" android:label="@string/series_details_title">
        <argument android:name="seriesId" app:argType="integer" />
    </fragment>
    <fragment android:id="@+id/myHeroesFragment" android:name="com.example.app_marvel.ui.myheroes.MyHeroesFragment" android:label="@string/my_heroes_title" />
</navigation>

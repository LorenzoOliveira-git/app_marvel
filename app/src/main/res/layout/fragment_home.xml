<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/screen_padding">
        <TextView android:id="@+id/recent_heading" style="@style/TextAppearance.Marvel.CatalogHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/catalog_recent" />
        <com.example.app_marvel.ui.components.MarvStateView android:id="@+id/recent_state" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recent_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:nestedScrollingEnabled="false" android:overScrollMode="never" />
        <TextView android:id="@+id/featured_heading" style="@style/TextAppearance.Marvel.CatalogHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="64dp" android:text="@string/catalog_featured" />
        <com.example.app_marvel.ui.components.MarvStateView android:id="@+id/featured_state" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <LinearLayout android:id="@+id/featured_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:visibility="gone">
            <com.google.android.material.card.MaterialCardView android:id="@+id/featured_image_card" android:layout_width="0dp" android:layout_weight="1.12" android:layout_height="314dp" app:cardCornerRadius="10dp" app:strokeWidth="0dp" app:cardBackgroundColor="@color/marvel_surface_raised">
                <ImageView android:id="@+id/featured_image" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:importantForAccessibility="no" />
            </com.google.android.material.card.MaterialCardView>
            <LinearLayout android:id="@+id/featured_details" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="18dp" android:orientation="vertical">
                <TextView android:id="@+id/featured_name" style="@style/TextAppearance.Marvel.CatalogTitle" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <TextView android:id="@+id/featured_description" style="@style/TextAppearance.Marvel.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
                <TextView android:id="@+id/featured_real_name" style="@style/TextAppearance.Marvel.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
                <TextView android:id="@+id/featured_origin" style="@style/TextAppearance.Marvel.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/featured_retry_origin" style="@style/Widget.Marvel.AuthLink" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/catalog_retry_translation" android:visibility="gone" />
                <com.google.android.material.button.MaterialButton android:id="@+id/featured_more" style="@style/Widget.Marvel.AuthLink" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/catalog_more" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/fact_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="40dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/fact_heading" style="@style/TextAppearance.Marvel.CatalogHeading" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/catalog_did_you_know" />
            <ImageView android:layout_width="64dp" android:layout_height="80dp" android:src="@drawable/marv_thinking" android:scaleType="fitCenter" android:contentDescription="@string/marv_content_description" />
        </LinearLayout>
        <com.example.app_marvel.ui.components.MarvStateView android:id="@+id/fact_state" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/fact_text" style="@style/TextAppearance.Marvel.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
        <TextView style="@style/TextAppearance.Marvel.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/catalog_source" />
        <TextView android:id="@+id/explore_heading" style="@style/TextAppearance.Marvel.CatalogTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:layout_marginBottom="8dp" android:text="@string/home_explore_title" />
        <com.example.app_marvel.ui.components.FeatureCardView android:id="@+id/characters_card" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <com.example.app_marvel.ui.components.FeatureCardView android:id="@+id/stories_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_md" />
        <com.example.app_marvel.ui.components.FeatureCardView android:id="@+id/create_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_md" />
        <com.example.app_marvel.ui.components.FeatureCardView android:id="@+id/profile_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_md" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

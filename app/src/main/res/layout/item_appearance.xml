<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
    <FrameLayout android:layout_width="32dp" android:layout_height="match_parent" android:importantForAccessibility="noHideDescendants">
        <View android:id="@+id/timeline_line" android:layout_width="1dp" android:layout_height="match_parent" android:layout_gravity="center_horizontal" android:layout_marginTop="24dp" android:background="@color/marvel_text_secondary" />
        <View android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="top|center_horizontal" android:layout_marginTop="4dp" android:background="@drawable/background_history_node" />
    </FrameLayout>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingStart="8dp" android:paddingEnd="0dp" android:paddingBottom="32dp" android:orientation="vertical">
        <TextView android:id="@+id/appearance_title" style="@style/TextAppearance.Marvel.CatalogTitle" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/appearance_date" style="@style/TextAppearance.Marvel.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="180dp" android:layout_marginTop="16dp" app:cardCornerRadius="10dp" app:strokeWidth="0dp" app:cardBackgroundColor="@color/marvel_surface_raised" app:cardElevation="0dp">
            <ImageView android:id="@+id/appearance_image" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" />
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton android:id="@+id/appearance_open" style="@style/Widget.Marvel.AuthLink" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/history_external" />
    </LinearLayout>
</LinearLayout>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
<FrameLayout android:layout_width="32dp" android:layout_height="match_parent" android:importantForAccessibility="noHideDescendants">
<View android:id="@+id/timeline_line" android:layout_width="1dp" android:layout_height="match_parent" android:layout_gravity="center_horizontal" android:layout_marginTop="24dp" android:background="@color/arquivo_borda" />
<View android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="top|center_horizontal" android:layout_marginTop="4dp" android:background="@drawable/background_history_node" />
</FrameLayout>
<LinearLayout android:id="@+id/appearance_content" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingStart="8dp" android:paddingBottom="32dp" android:orientation="horizontal" android:baselineAligned="false">
<com.google.android.material.imageview.ShapeableImageView android:id="@+id/appearance_image" android:layout_width="80dp" android:layout_height="120dp" android:scaleType="fitCenter" android:background="@color/arquivo_folha" android:importantForAccessibility="no" app:shapeAppearanceOverlay="@style/ShapeAppearance.Marvel.Cover" />
<LinearLayout android:id="@+id/appearance_metadata" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:orientation="vertical">
<TextView android:id="@+id/appearance_title" style="@style/TextAppearance.Marvel.CardTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" />
<TextView android:id="@+id/appearance_date" style="@style/TextAppearance.Marvel.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
<com.google.android.material.button.MaterialButton android:id="@+id/appearance_open" style="@style/Widget.Marvel.AuthLink" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/history_external" />
</LinearLayout>
</LinearLayout>
</LinearLayout>

<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginEnd="8dp" app:cardCornerRadius="@dimen/card_radius" app:strokeWidth="1dp" app:strokeColor="@color/arquivo_borda" app:cardBackgroundColor="@color/marvel_surface_raised">
    <LinearLayout android:id="@+id/issue_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/background_recent_issue">
        <ImageView android:id="@+id/issue_image" android:layout_width="80dp" android:layout_height="120dp" android:layout_margin="12dp" android:scaleType="fitCenter" android:importantForAccessibility="no" />
        <LinearLayout android:id="@+id/issue_details" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="12dp" android:paddingBottom="12dp" android:paddingEnd="12dp">
            <TextView style="@style/TextAppearance.Marvel.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/catalog_issue" />
            <TextView android:id="@+id/issue_title" android:maxLines="2" android:ellipsize="end" style="@style/TextAppearance.Marvel.CardTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
            <TextView android:id="@+id/issue_date" style="@style/TextAppearance.Marvel.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
            <TextView android:id="@+id/issue_volume" style="@style/TextAppearance.Marvel.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/issue_more" style="@style/Widget.Marvel.AuthLink" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/catalog_more" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/characters_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/screen_padding">
            <TextView style="@style/TextAppearance.Marvel.AuthLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:labelFor="@id/search_name" android:text="@string/arquivo_character_search" />
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Marvel.SearchInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/search_name" style="@style/Widget.Marvel.AuthEditText" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/arquivo_character_search" android:inputType="text" android:imeOptions="actionSearch" android:maxLines="1" android:minHeight="52dp" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView style="@style/TextAppearance.Marvel.CatalogFilter" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/catalog_filter_by" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/origin_filter" style="@style/Widget.Marvel.CatalogFilter" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/catalog_origin" />
                <com.google.android.material.button.MaterialButton android:id="@+id/team_filter" style="@style/Widget.Marvel.CatalogFilter" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/catalog_teams" />
                <com.google.android.material.button.MaterialButton android:id="@+id/gender_filter" style="@style/Widget.Marvel.CatalogFilter" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/catalog_profile" />
            </LinearLayout>
                        <com.google.android.material.button.MaterialButton android:id="@+id/clear_filters" style="@style/Widget.Marvel.AuthLink" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/catalog_clear_filters" android:visibility="gone" />
        </LinearLayout>
        <com.example.app_marvel.ui.components.MarvStateView android:id="@+id/catalog_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" />
        <LinearLayout android:id="@+id/catalog_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/selection_count" style="@style/TextAppearance.Marvel.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start" android:paddingHorizontal="@dimen/screen_padding" android:layout_marginTop="16dp" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/portraits" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:paddingHorizontal="36dp" android:clipToPadding="false" android:nestedScrollingEnabled="true" android:overScrollMode="never" />
        </LinearLayout>
        <ProgressBar android:id="@+id/page_progress" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center_horizontal" android:layout_marginTop="16dp" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/load_more" style="@style/Widget.Marvel.AuthLink" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:text="@string/catalog_load_more" android:visibility="gone" />
        <TextView style="@style/TextAppearance.Marvel.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:padding="20dp" android:gravity="center" android:text="@string/catalog_source" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

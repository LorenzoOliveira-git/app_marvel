<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/arc_details_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/screen_padding">
        <com.example.app_marvel.ui.components.MarvStateView android:id="@+id/arc_details_state" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <LinearLayout android:id="@+id/arc_details_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <ImageView android:id="@+id/arc_details_image" android:layout_width="match_parent" android:layout_height="340dp" android:scaleType="fitCenter" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/arc_details_heading" style="@style/TextAppearance.Marvel.Display" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" />
                    <TextView style="@style/TextAppearance.Marvel.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/arcs_publisher" />
                    <TextView android:id="@+id/arc_reference_count" style="@style/TextAppearance.Marvel.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/arc_deck_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="32dp">
                <TextView android:id="@+id/arc_deck_heading" style="@style/Widget.Marvel.SectionHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/issue_summary" />
                <com.example.app_marvel.ui.components.MarvStateView android:id="@+id/arc_deck_state" android:layout_width="match_parent" android:layout_height="wrap_content" app:inlineState="true" app:textOnlySkeleton="true" />
                <TextView android:id="@+id/arc_deck" style="@style/TextAppearance.Marvel.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textColor="@color/marvel_text" />
            </LinearLayout>
            <LinearLayout android:id="@+id/arc_issues_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="32dp">
                <TextView android:id="@+id/arc_issues_heading" style="@style/Widget.Marvel.SectionHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/arc_issues_heading" />
                <TextView style="@style/TextAppearance.Marvel.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/arc_sequence_note" />
                <com.example.app_marvel.ui.components.MarvStateView android:id="@+id/arc_issues_state" android:layout_width="match_parent" android:layout_height="wrap_content" app:inlineState="true" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/arc_issues_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:nestedScrollingEnabled="false" />
                <ProgressBar android:id="@+id/arc_issues_progress" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" android:visibility="gone" android:indeterminateTint="@color/marvel_primary" />
                <com.google.android.material.button.MaterialButton android:id="@+id/arc_issues_more" style="@style/Widget.Marvel.AuthLink" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/arc_more_issues" android:visibility="gone" />
            </LinearLayout>
            <LinearLayout android:id="@+id/arc_description_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="32dp">
                <TextView android:id="@+id/arc_description_heading" style="@style/Widget.Marvel.SectionHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/issue_description" />
                <com.example.app_marvel.ui.components.MarvStateView android:id="@+id/arc_description_state" android:layout_width="match_parent" android:layout_height="wrap_content" app:inlineState="true" app:textOnlySkeleton="true" />
                <com.google.android.material.button.MaterialButton android:id="@+id/arc_read_description" style="@style/Widget.Marvel.AuthLink" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/arc_read_description" />
                <TextView android:id="@+id/arc_description" style="@style/TextAppearance.Marvel.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textColor="@color/marvel_text" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

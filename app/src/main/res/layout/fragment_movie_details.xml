<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/movie_details_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/screen_padding">
        <com.example.app_marvel.ui.components.MarvStateView android:id="@+id/movie_details_state" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <LinearLayout android:id="@+id/movie_details_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardBackgroundColor="@color/marvel_surface_raised" app:strokeWidth="0dp" app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <ImageView android:id="@+id/movie_details_image" android:layout_width="match_parent" android:layout_height="340dp" android:scaleType="fitCenter" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/movie_details_heading" style="@style/TextAppearance.Marvel.Display" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" />
                    <TextView style="@style/TextAppearance.Marvel.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/movies_association" />
                    <TextView android:id="@+id/movie_details_runtime" style="@style/TextAppearance.Marvel.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
                    <TextView android:id="@+id/movie_details_rating" style="@style/TextAppearance.Marvel.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
                    <TextView android:id="@+id/movie_details_distributor" style="@style/TextAppearance.Marvel.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <LinearLayout android:id="@+id/movie_deck_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="32dp">
                <TextView android:id="@+id/movie_deck_heading" style="@style/Widget.Marvel.SectionHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/issue_summary" />
                <com.example.app_marvel.ui.components.MarvStateView android:id="@+id/movie_deck_state" android:layout_width="match_parent" android:layout_height="wrap_content" app:inlineState="true" app:textOnlySkeleton="true" />
                <TextView android:id="@+id/movie_deck" style="@style/TextAppearance.Marvel.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textColor="@color/marvel_text" />
            </LinearLayout>
            <include android:id="@+id/movie_characters_section" layout="@layout/component_details_relations" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" />
            <include android:id="@+id/movie_teams_section" layout="@layout/component_details_relations" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" />
            <LinearLayout android:id="@+id/movie_credits" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <LinearLayout android:id="@+id/movie_description_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="32dp">
                <TextView android:id="@+id/movie_description_heading" style="@style/Widget.Marvel.SectionHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/issue_description" />
                <com.example.app_marvel.ui.components.MarvStateView android:id="@+id/movie_description_state" android:layout_width="match_parent" android:layout_height="wrap_content" app:inlineState="true" app:textOnlySkeleton="true" />
                <com.google.android.material.button.MaterialButton android:id="@+id/movie_read_description" style="@style/Widget.Marvel.AuthLink" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/movie_read_description" />
                <TextView android:id="@+id/movie_description" style="@style/TextAppearance.Marvel.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textColor="@color/marvel_text" />
            </LinearLayout>
            <TextView style="@style/TextAppearance.Marvel.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:text="@string/issue_source" />
            <com.google.android.material.button.MaterialButton android:id="@+id/movie_details_source" style="@style/Widget.Marvel.AuthLink" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/details_external" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

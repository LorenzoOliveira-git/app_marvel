<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/auth_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="36dp" android:paddingEnd="36dp" android:paddingTop="78dp" android:paddingBottom="@dimen/space_lg">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
            <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/auth_login_title" android:textAppearance="@style/TextAppearance.Marvel.AuthTitle"
                android:fontFamily="@font/bebas_neue_regular" app:fontFamily="@font/bebas_neue_regular" />
            <ImageView android:id="@+id/marv" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="@dimen/space_sm"
                android:src="@drawable/marv_welcome" android:scaleType="fitCenter" android:importantForAccessibility="no" android:contentDescription="@null" />
        </LinearLayout>
        <TextView android:id="@+id/name_label" style="@style/TextAppearance.Marvel.AuthLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="32dp" android:text="@string/auth_name" android:labelFor="@id/name" android:visibility="gone" />
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/name_layout" style="@style/Widget.Marvel.AuthInput" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:visibility="gone">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/name" style="@style/Widget.Marvel.AuthEditText" android:hint="@string/auth_name_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textPersonName" android:singleLine="true" android:imeOptions="actionNext" android:autofillHints="personName" android:maxLength="100" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:id="@+id/email_label" style="@style/TextAppearance.Marvel.AuthLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="56dp" android:text="@string/auth_email" android:labelFor="@id/email" />
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/email_layout" style="@style/Widget.Marvel.AuthInput" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/email" style="@style/Widget.Marvel.AuthEditText" android:hint="@string/auth_email_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textEmailAddress" android:singleLine="true" android:imeOptions="actionNext" android:autofillHints="emailAddress" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:id="@+id/password_label" style="@style/TextAppearance.Marvel.AuthLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="60dp" android:text="@string/auth_password" android:labelFor="@id/password" />
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/password_layout" style="@style/Widget.Marvel.AuthInput" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" app:endIconMode="password_toggle" app:endIconTint="@color/marvel_text">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/password" style="@style/Widget.Marvel.AuthEditText" android:hint="@string/auth_password_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textPassword" android:singleLine="true" android:imeOptions="actionDone" android:autofillHints="password" android:saveEnabled="false" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:id="@+id/confirmation_label" style="@style/TextAppearance.Marvel.AuthLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="32dp" android:text="@string/auth_confirmation" android:labelFor="@id/confirmation" android:visibility="gone" />
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/confirmation_layout" style="@style/Widget.Marvel.AuthInput" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:visibility="gone" app:endIconMode="password_toggle" app:endIconTint="@color/marvel_text">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/confirmation" style="@style/Widget.Marvel.AuthEditText" android:hint="@string/auth_confirmation_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textPassword" android:singleLine="true" android:imeOptions="actionDone" android:saveEnabled="false" android:importantForAutofill="no" />
        </com.google.android.material.textfield.TextInputLayout>
        <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp"
            android:layout_marginTop="@dimen/space_lg" android:indeterminate="true" android:visibility="gone" android:importantForAccessibility="no" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_md"
            android:visibility="gone" android:accessibilityLiveRegion="polite" android:textAppearance="@style/TextAppearance.Marvel.Body" />
        <com.google.android.material.button.MaterialButton android:id="@+id/submit" style="@style/Widget.Marvel.AuthButton" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg" android:text="@string/auth_sign_in" />
        <com.google.android.material.button.MaterialButton android:id="@+id/switch_form" style="@style/Widget.Marvel.AuthLink" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md" android:text="@string/auth_go_register" />
        <com.google.android.material.button.MaterialButton android:id="@+id/browse" style="@style/Widget.Marvel.AuthLink" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm" android:text="@string/auth_browse" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/history_identity" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
    <LinearLayout android:id="@+id/identity_text" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="16dp" android:orientation="vertical">
        <TextView android:id="@+id/identity_name" style="@style/TextAppearance.Marvel.CatalogTitle" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <com.example.app_marvel.ui.components.MarvStateView android:id="@+id/identity_description_state" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/identity_description" style="@style/TextAppearance.Marvel.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
        <TextView android:id="@+id/identity_real_name" style="@style/TextAppearance.Marvel.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" />
        <TextView android:id="@+id/identity_origin" style="@style/TextAppearance.Marvel.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" />
        <ProgressBar android:id="@+id/identity_origin_progress" android:layout_width="24dp" android:layout_height="24dp" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/identity_origin_retry" style="@style/Widget.Marvel.AuthLink" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/catalog_retry_translation" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/identity_open" style="@style/Widget.Marvel.HistoryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/history_open" />
    </LinearLayout>
    <com.google.android.material.card.MaterialCardView android:id="@+id/identity_image_card" android:layout_width="0dp" android:layout_weight="1.25" android:layout_height="290dp" app:cardCornerRadius="10dp" app:cardBackgroundColor="@color/marvel_surface_raised" app:cardElevation="0dp" app:strokeWidth="0dp">
        <ImageView android:id="@+id/identity_image" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:importantForAccessibility="no" />
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>

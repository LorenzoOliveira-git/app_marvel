<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/details_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <com.example.app_marvel.ui.components.MarvStateView android:id="@+id/details_state" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <LinearLayout android:id="@+id/details_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/background_character_identity" android:orientation="vertical">
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="237dp" app:cardCornerRadius="20dp" app:cardBackgroundColor="@color/marvel_surface_raised" app:strokeWidth="0dp" app:cardElevation="0dp">
                    <ImageView android:id="@+id/details_image" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:importantForAccessibility="no" />
                </com.google.android.material.card.MaterialCardView>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/screen_padding" android:paddingBottom="32dp">
                    <TextView android:id="@+id/details_name" style="@style/TextAppearance.Marvel.CatalogHeading" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/details_real_name" style="@style/TextAppearance.Marvel.CatalogFilter" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" />
                    <TextView android:id="@+id/details_origin" style="@style/TextAppearance.Marvel.CatalogFilter" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
                    <ProgressBar android:id="@+id/origin_progress" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginTop="8dp" android:visibility="gone" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/origin_retry" style="@style/Widget.Marvel.AuthLink" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/catalog_retry_translation" android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/screen_padding">
                <LinearLayout android:id="@+id/description_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical">
                    <TextView android:id="@+id/description_heading" style="@style/TextAppearance.Marvel.CatalogHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/details_description" />
                    <com.example.app_marvel.ui.components.MarvStateView android:id="@+id/description_state" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/details_description" style="@style/TextAppearance.Marvel.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textColor="@color/marvel_text" />
                </LinearLayout>
                <LinearLayout android:id="@+id/appearance_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:orientation="horizontal" android:baselineAligned="false">
                    <LinearLayout android:id="@+id/first_section" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="12dp" android:background="@drawable/background_detail_stat" android:padding="16dp" android:orientation="vertical">
                        <TextView android:id="@+id/first_heading" style="@style/TextAppearance.Marvel.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/details_first_appearance" />
                        <com.example.app_marvel.ui.components.MarvStateView android:id="@+id/first_state" android:layout_width="match_parent" android:layout_height="wrap_content" />
                        <TextView android:id="@+id/first_title" style="@style/TextAppearance.Marvel.CatalogFilter" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
                        <TextView android:id="@+id/first_date" style="@style/TextAppearance.Marvel.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/first_more" style="@style/Widget.Marvel.AuthLink" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/details_team_external" android:textSize="16sp" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/count_section" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:background="@drawable/background_detail_stat" android:padding="16dp" android:orientation="vertical">
                        <TextView style="@style/TextAppearance.Marvel.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/details_appearance_count" />
                        <TextView android:id="@+id/appearance_count" style="@style/TextAppearance.Marvel.CatalogFilter" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:id="@+id/powers_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="40dp" android:orientation="vertical">
                    <TextView android:id="@+id/powers_heading" style="@style/TextAppearance.Marvel.CatalogHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/details_powers" />
                    <com.example.app_marvel.ui.components.MarvStateView android:id="@+id/powers_state" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <com.google.android.material.chip.ChipGroup android:id="@+id/power_labels" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:chipSpacingHorizontal="12dp" app:chipSpacingVertical="8dp" />
                </LinearLayout>
                <include android:id="@+id/teams_section" layout="@layout/component_details_relations" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="40dp" />
                <include android:id="@+id/friends_section" layout="@layout/component_details_relations" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="40dp" />
                <include android:id="@+id/enemies_section" layout="@layout/component_details_relations" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="40dp" />
                <TextView style="@style/TextAppearance.Marvel.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:text="@string/details_source_caption" />
                <com.google.android.material.button.MaterialButton android:id="@+id/details_source" style="@style/Widget.Marvel.AuthLink" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/details_external" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

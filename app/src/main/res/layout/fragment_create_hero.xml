<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/hero_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/screen_padding">
        <TextView android:id="@+id/hero_step" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/hero_identity_title" style="@style/TextAppearance.Marvel.Caption" />
        <TextView android:id="@+id/hero_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/hero_identity_title" style="@style/TextAppearance.Marvel.Title" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:padding="12dp" android:background="@drawable/background_marv_tip">
            <com.example.app_marvel.ui.components.MarvCompanionView android:id="@+id/hero_marv" android:layout_width="132dp" android:layout_height="132dp" android:layout_gravity="center_horizontal" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/marv_companion_label" style="@style/TextAppearance.Marvel.Label" />
            <TextView android:id="@+id/hero_guide" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/marv_identity" android:accessibilityLiveRegion="polite" style="@style/TextAppearance.Marvel.Body" />
            <com.google.android.material.button.MaterialButton android:id="@+id/hero_marv_hint" style="@style/Widget.Marvel.AuthLink" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="false" android:text="@string/marv_next_tip" />
        </LinearLayout>
        <LinearLayout android:id="@+id/hero_identity" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/hero_name_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/hero_name" style="@style/TextAppearance.Marvel.AuthLabel" android:labelFor="@id/hero_name" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/hero_name_input" style="@style/Widget.Marvel.AuthInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/hero_name" style="@style/Widget.Marvel.AuthEditText" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords" android:singleLine="true" android:imeOptions="actionNext" android:gravity="top|start" android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:id="@+id/hero_real_name_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/hero_real_name" style="@style/TextAppearance.Marvel.AuthLabel" android:labelFor="@id/hero_real_name" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/hero_real_name_input" style="@style/Widget.Marvel.AuthInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/hero_real_name" style="@style/Widget.Marvel.AuthEditText" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords" android:singleLine="true" android:imeOptions="actionNext" android:gravity="top|start" android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:id="@+id/hero_birthday_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/hero_birthday" style="@style/TextAppearance.Marvel.AuthLabel" />
            <com.google.android.material.button.MaterialButton android:id="@+id/hero_birthday" style="@style/Widget.Marvel.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:singleLine="false" android:text="@string/hero_choose_date" />
            <com.google.android.material.button.MaterialButton android:id="@+id/hero_clear_birthday" style="@style/Widget.Marvel.AuthLink" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:singleLine="false" android:text="@string/hero_clear_date" />
        </LinearLayout>
        <LinearLayout android:id="@+id/hero_abilities" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/hero_origin_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/hero_origin" style="@style/TextAppearance.Marvel.AuthLabel" />
            <TextView android:id="@+id/hero_origin_help" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/hero_origin_help" style="@style/TextAppearance.Marvel.Caption" />
            <com.google.android.material.button.MaterialButton android:id="@+id/hero_origin" style="@style/Widget.Marvel.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:singleLine="false" android:text="@string/hero_choose_origin" />
            <TextView android:id="@+id/hero_origin_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/hero_loading_origins" style="@style/TextAppearance.Marvel.Caption" />
            <com.google.android.material.button.MaterialButton android:id="@+id/hero_origin_retry" style="@style/Widget.Marvel.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:singleLine="false" android:text="@string/catalog_retry" />
            <TextView android:id="@+id/hero_origin_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/hero_origin_required" style="@style/TextAppearance.Marvel.Caption" />
            <TextView android:id="@+id/hero_powers_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/hero_powers" style="@style/TextAppearance.Marvel.AuthLabel" />
            <TextView android:id="@+id/hero_selected_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/hero_selected_powers" style="@style/TextAppearance.Marvel.Caption" />
            <LinearLayout android:id="@+id/hero_selected_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <LinearLayout android:id="@+id/hero_power_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <TextView android:id="@+id/hero_power_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/hero_loading_powers" style="@style/TextAppearance.Marvel.Caption" />
            <ProgressBar android:id="@+id/hero_catalog_progress" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/hero_power_more" style="@style/Widget.Marvel.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:singleLine="false" android:text="@string/hero_more_powers" />
            <TextView android:id="@+id/hero_power_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/hero_power_required" style="@style/TextAppearance.Marvel.Caption" />
            <TextView android:id="@+id/hero_catalog_source" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/hero_catalog_source" style="@style/TextAppearance.Marvel.Caption" />
            <TextView android:id="@+id/hero_description_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/hero_description" style="@style/TextAppearance.Marvel.AuthLabel" android:labelFor="@id/hero_description" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/hero_description_input" style="@style/Widget.Marvel.AuthInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/hero_description" style="@style/Widget.Marvel.AuthEditText" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences|textMultiLine" android:singleLine="false" android:imeOptions="actionDone" android:gravity="top|start" android:importantForAutofill="no" android:minLines="4" android:hint="@string/hero_description_hint" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/hero_review_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/hero_review_data" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/hero_review_title" style="@style/TextAppearance.Marvel.Body" />
            <TextView android:id="@+id/hero_review_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/hero_review_note" style="@style/TextAppearance.Marvel.Caption" />
            <com.google.android.material.button.MaterialButton android:id="@+id/hero_save_draft" style="@style/Widget.Marvel.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:singleLine="false" android:text="@string/hero_save_draft" android:visibility="gone" />
            <ProgressBar android:id="@+id/hero_draft_progress" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" android:visibility="gone" />
            <TextView android:id="@+id/hero_draft_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:accessibilityLiveRegion="polite" style="@style/TextAppearance.Marvel.Body" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/hero_generate" style="@style/Widget.Marvel.Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:singleLine="false" android:text="@string/hero_generate" android:visibility="gone" />
            <ProgressBar android:id="@+id/hero_creation_progress" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" android:visibility="gone" />
            <TextView android:id="@+id/hero_creation_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:accessibilityLiveRegion="polite" style="@style/TextAppearance.Marvel.Body" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/hero_resume_creation" style="@style/Widget.Marvel.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:singleLine="false" android:text="@string/hero_resume_creation" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/hero_retry_generation" style="@style/Widget.Marvel.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:singleLine="false" android:text="@string/hero_retry_generation" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/hero_open_saved" style="@style/Widget.Marvel.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:singleLine="false" android:text="@string/hero_open_saved" android:visibility="gone" />
            <TextView android:id="@+id/hero_saved_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" style="@style/TextAppearance.Marvel.Title" android:visibility="gone" />
            <ImageView android:id="@+id/hero_generated_image" android:layout_width="match_parent" android:layout_height="wrap_content" android:adjustViewBounds="true" android:maxHeight="560dp" android:scaleType="fitCenter" android:layout_marginTop="16dp" android:contentDescription="@string/hero_generated_image" android:visibility="gone" />
            <TextView android:id="@+id/hero_image_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" style="@style/TextAppearance.Marvel.Body" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/hero_reload_image" style="@style/Widget.Marvel.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:singleLine="false" android:text="@string/hero_reload_image" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/hero_new_character" style="@style/Widget.Marvel.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:singleLine="false" android:text="@string/hero_new_character" android:visibility="gone" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/hero_next" style="@style/Widget.Marvel.Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:singleLine="false" android:text="@string/hero_next" />
        <com.google.android.material.button.MaterialButton android:id="@+id/hero_previous" style="@style/Widget.Marvel.AuthLink" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:singleLine="false" android:text="@string/hero_previous" />
        <TextView android:id="@+id/hero_draft_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/hero_draft_note" style="@style/TextAppearance.Marvel.Caption" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/collection_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/screen_padding">
<TextView android:id="@+id/collection_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/my_heroes_title" android:textAppearance="@style/TextAppearance.Marvel.AuthTitle" />
<ImageView android:layout_width="96dp" android:layout_height="108dp" android:layout_gravity="center_horizontal" android:layout_marginTop="16dp" android:src="@drawable/marv_welcome" android:importantForAccessibility="no" android:contentDescription="@null" />
<TextView android:id="@+id/collection_intro" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/my_heroes_intro" android:textAppearance="@style/TextAppearance.Marvel.Body" />
<ProgressBar android:id="@+id/collection_progress" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center_horizontal" android:visibility="gone" />
<TextView android:id="@+id/collection_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:accessibilityLiveRegion="polite" android:textAppearance="@style/TextAppearance.Marvel.Body" />
<LinearLayout android:id="@+id/collection_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
<com.google.android.material.button.MaterialButton android:id="@+id/collection_refresh" style="@style/Widget.Marvel.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:singleLine="false" android:text="@string/my_heroes_refresh" />
<com.google.android.material.button.MaterialButton android:id="@+id/collection_more" style="@style/Widget.Marvel.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:singleLine="false" android:text="@string/my_heroes_more" />
<com.google.android.material.button.MaterialButton android:id="@+id/collection_create" style="@style/Widget.Marvel.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:singleLine="false" android:text="@string/my_heroes_create" />
<LinearLayout android:id="@+id/collection_editor" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/my_heroes_fixed_image" android:textAppearance="@style/TextAppearance.Marvel.Body" />
<ImageView android:id="@+id/collection_image" android:layout_width="match_parent" android:layout_height="wrap_content" android:adjustViewBounds="true" android:maxHeight="560dp" android:scaleType="fitCenter" android:layout_marginTop="16dp" android:contentDescription="@string/hero_generated_image" android:visibility="gone" />
<com.google.android.material.button.MaterialButton android:id="@+id/collection_image_retry" style="@style/Widget.Marvel.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:singleLine="false" android:text="@string/hero_reload_image" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/hero_name" android:labelFor="@id/edit_hero_name" android:textAppearance="@style/TextAppearance.Marvel.AuthLabel" />
<com.google.android.material.textfield.TextInputLayout style="@style/Widget.Marvel.AuthInput" android:layout_width="match_parent" android:layout_height="wrap_content"><com.google.android.material.textfield.TextInputEditText android:id="@+id/edit_hero_name" style="@style/Widget.Marvel.AuthEditText" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords" android:maxLength="100" android:singleLine="true" /></com.google.android.material.textfield.TextInputLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/hero_real_name" android:labelFor="@id/edit_real_name" android:textAppearance="@style/TextAppearance.Marvel.AuthLabel" />
<com.google.android.material.textfield.TextInputLayout style="@style/Widget.Marvel.AuthInput" android:layout_width="match_parent" android:layout_height="wrap_content"><com.google.android.material.textfield.TextInputEditText android:id="@+id/edit_real_name" style="@style/Widget.Marvel.AuthEditText" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords" android:maxLength="100" android:singleLine="true" /></com.google.android.material.textfield.TextInputLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/hero_description" android:labelFor="@id/edit_description" android:textAppearance="@style/TextAppearance.Marvel.AuthLabel" />
<com.google.android.material.textfield.TextInputLayout style="@style/Widget.Marvel.AuthInput" android:layout_width="match_parent" android:layout_height="wrap_content"><com.google.android.material.textfield.TextInputEditText android:id="@+id/edit_description" style="@style/Widget.Marvel.AuthEditText" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences|textMultiLine" android:maxLength="2000" android:singleLine="false" /></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/collection_save" style="@style/Widget.Marvel.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:singleLine="false" android:text="@string/my_heroes_save" />
<com.google.android.material.button.MaterialButton android:id="@+id/collection_reload" style="@style/Widget.Marvel.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:singleLine="false" android:text="@string/my_heroes_reload" />
<com.google.android.material.button.MaterialButton android:id="@+id/collection_close" style="@style/Widget.Marvel.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:singleLine="false" android:text="@string/my_heroes_close" />
</LinearLayout>
</LinearLayout></androidx.core.widget.NestedScrollView>

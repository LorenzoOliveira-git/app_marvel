# Copie para backend/.env.local. Preencha valores SOMENTE no arquivo privado local.
# Não habilite antes de configurar acesso e conferir a conta Cloudflare.
HERO_GENERATION_ENABLED=false
COMICVINE_API_KEY=
# API Token com Workers AI Write (usado como Bearer; não Global API Key).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
